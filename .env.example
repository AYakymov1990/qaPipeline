# Скопіюйте у .env і заповніть. .env не комітиться.

# Тестовий стенд (НЕ прод). 5 стендів: <версія>.seller1.vus.us … <версія>.seller5.vus.us
# Регіональна версія — префікс хоста: avto, es, pt, pl, tr, ua.
# Номер стенду під задачу вказує QA — замініть seller1 на потрібний. Перевірте схему (https / http).
TEST_STAND=seller1
BASE_URL_AVTO=https://avto.seller1.vus.us
BASE_URL_ES=https://es.seller1.vus.us
BASE_URL_PT=https://pt.seller1.vus.us
BASE_URL_PL=https://pl.seller1.vus.us
BASE_URL_TR=https://tr.seller1.vus.us
BASE_URL_UA=https://ua.seller1.vus.us

# Доступ до закритого тестового стенду (зберігається в cookie TestEnvAccessToken, 7 днів)
TEST_ENV_PASSWORD=

# Тестові акаунти. ТІЛЬКИ користувачі зі StaticUserHelper.TestUsers:
# під звичайним акаунтом навіть на стенді працюють бойові контури Stripe і Recalvi.

# Покупці
TEST_BUYER_0_LOGIN=
TEST_BUYER_0_PASSWORD=
TEST_BUYER_2_LOGIN=
TEST_BUYER_2_PASSWORD=
TEST_BUYER_3_LOGIN=
TEST_BUYER_3_PASSWORD=
TEST_BUYER_5_LOGIN=
TEST_BUYER_5_PASSWORD=
TEST_BUYER_10_LOGIN=
TEST_BUYER_10_PASSWORD=
# Покупець для чекауту ES/PT (ID акаунта 1075831). ID — для ручного тестування; агенту потрібні логін і пароль
TEST_BUYER_ES_LOGIN=
TEST_BUYER_ES_PASSWORD=

# Продавці
TEST_SELLER_0_LOGIN=
TEST_SELLER_0_PASSWORD=
TEST_SELLER_10_LOGIN=
TEST_SELLER_10_PASSWORD=
TEST_SELLER_20_LOGIN=
TEST_SELLER_20_PASSWORD=
# Продавець 1082119 (тестовий, увімкнено Seur, задача 127593)
TEST_SELLER_SEUR_LOGIN=
TEST_SELLER_SEUR_PASSWORD=
# Продавець Genei 1049862 (тестові замовлення Genei, збережена адреса типу 25; задача 127593)
TEST_SELLER_GENEI_LOGIN=
TEST_SELLER_GENEI_PASSWORD=

# Співробітник із BPanel-роллю QA (службові API Seur: тарифи, паливна надбавка, відправлення)
TEST_BPANEL_QA_LOGIN=
TEST_BPANEL_QA_PASSWORD=

# Автосервіс
TEST_SERVICE_20_LOGIN=
TEST_SERVICE_20_PASSWORD=

